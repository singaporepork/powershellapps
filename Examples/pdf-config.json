{
  "ModuleName": "PdfTextReader",
  "Version": "1.0.0",
  "Dependencies": {
    "iTextSharp": {
      "Version": "5.5.13.3",
      "DownloadUrl": "https://github.com/itext/itextsharp/releases/tag/5.5.13.3",
      "NuGetUrl": "https://www.nuget.org/packages/iTextSharp/5.5.13.3",
      "License": "AGPL/LGPL"
    }
  },
  "InstallPaths": [
    "Modules/lib/itextsharp.dll",
    "C:/Program Files/iTextSharp/itextsharp.dll",
    "%USERPROFILE%/Documents/PowerShell/Modules/iTextSharp/itextsharp.dll"
  ],
  "DefaultSettings": {
    "Encoding": "UTF8",
    "PageSeparator": "\n\n",
    "Verbose": false
  },
  "Examples": {
    "ReadEntirePdf": {
      "Command": "Read-PdfText -FilePath 'document.pdf'",
      "Description": "Extract text from all pages"
    },
    "ReadSpecificPages": {
      "Command": "Read-PdfText -FilePath 'document.pdf' -Pages 1,3,5",
      "Description": "Extract text from specific pages"
    },
    "ReadPageRange": {
      "Command": "Read-PdfText -FilePath 'document.pdf' -StartPage 2 -EndPage 5",
      "Description": "Extract text from a range of pages"
    },
    "GetPdfInfo": {
      "Command": "Get-PdfInfo -FilePath 'document.pdf'",
      "Description": "Get PDF metadata and information"
    },
    "ExportToText": {
      "Command": "Export-PdfToText -PdfPath 'document.pdf' -OutputPath 'output.txt'",
      "Description": "Export PDF text to a file"
    },
    "SearchText": {
      "Command": "Search-PdfText -FilePath 'document.pdf' -Pattern 'search term'",
      "Description": "Search for text in PDF"
    },
    "RegexSearch": {
      "Command": "Search-PdfText -FilePath 'document.pdf' -Pattern '\\d{3}-\\d{3}-\\d{4}' -UseRegex",
      "Description": "Search using regular expressions"
    }
  },
  "CommonUseCases": [
    "Extracting invoice data from PDF invoices",
    "Converting PDF reports to text for analysis",
    "Searching for specific information in PDF documents",
    "Batch processing PDF archives",
    "Creating searchable text indexes from PDF libraries",
    "Extracting contract terms and conditions",
    "Processing forms and applications"
  ]
}
